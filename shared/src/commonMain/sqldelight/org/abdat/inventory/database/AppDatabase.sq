selectAllAuditLogs:
SELECT a.*, s.designation AS article_designation, s.code_article AS article_code
FROM article_audit_log a
JOIN stock_article s ON a.article_id = s.id
ORDER BY a.edit_date DESC, a.id DESC;

insertArticleAuditLog:
INSERT INTO article_audit_log (article_id, field_name, old_value, new_value, reason, user_name, edit_date)
VALUES (?, ?, ?, ?, ?, ?, ?);

