insertFournisseur:
INSERT INTO fournisseur (full_name) VALUES (?);

insertFournisseurFull:
INSERT INTO fournisseur (full_name, societe, phone, responsable_phone, ville, email, other_links)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateFournisseur:
UPDATE fournisseur SET full_name = ? WHERE id = ?;

updateFournisseurProfile:
UPDATE fournisseur
SET full_name = ?,
    societe = ?,
    phone = ?,
    responsable_phone = ?,
    ville = ?,
    email = ?,
    other_links = ?
WHERE id = ?;

deleteFournisseur:
DELETE FROM fournisseur WHERE id = ?;

-- ============================================================================
-- Convention & Convention Items Queries
-- ============================================================================

selectAllConventions:
SELECT * FROM convention ORDER BY date DESC, ord_number ASC;

selectConventionById:
SELECT * FROM convention WHERE id = ?;

selectConventionsByFournisseur:
SELECT * FROM convention WHERE fournisseur_id = ? ORDER BY date DESC;

insertConvention:
INSERT INTO convention (fournisseur_id, ord_number, date, global_unit_price, total_montant, tva_rate)
VALUES (?, ?, ?, ?, ?, ?);

updateConvention:
UPDATE convention 
SET fournisseur_id = ?, ord_number = ?, date = ?, global_unit_price = ?, total_montant = ?, tva_rate = ? 
WHERE id = ?;

deleteConvention:
DELETE FROM convention WHERE id = ?;

selectAllConventionItems:
SELECT * FROM convention_item;

selectConventionItemsByConventionId:
SELECT * FROM convention_item WHERE convention_id = ? ORDER BY designation ASC;

selectConventionItemById:
SELECT * FROM convention_item WHERE id = ?;

insertConventionItem:
INSERT INTO convention_item (convention_id, designation, unite, quantity, min_quantity)
VALUES (?, ?, ?, ?, ?);

updateConventionItem:
UPDATE convention_item 
SET designation = ?, unite = ?, quantity = ?, min_quantity = ? 
WHERE id = ?;

deleteConventionItem:
DELETE FROM convention_item WHERE id = ?;

-- Quota Balance Queries
selectConventionItemBalance:
SELECT 
    ci.id AS conventionItemId,
    ci.convention_id AS conventionId,
    ci.designation AS designation,
    ci.quantity AS agreedQuantity,
    ci.min_quantity AS minQuantity,
    COALESCE(SUM(CASE WHEN bdc.is_debt = 0 THEN co.quantity ELSE 0 END), 0.0) AS orderedQuantity,
    (ci.quantity - COALESCE(SUM(CASE WHEN bdc.is_debt = 0 THEN co.quantity ELSE 0 END), 0.0)) AS remainingQuantity
FROM convention_item ci
LEFT JOIN commande_item co ON co.convention_item_id = ci.id
LEFT JOIN bon_de_commande bdc ON co.commande_id = bdc.id
WHERE ci.id = ?
GROUP BY ci.id;

selectConventionBalancesByConventionId:
SELECT 
    ci.id AS conventionItemId,
    ci.convention_id AS conventionId,
    ci.designation AS designation,
    ci.unite AS unite,
    ci.quantity AS agreedQuantity,
    ci.min_quantity AS minQuantity,
    COALESCE(SUM(CASE WHEN bdc.is_debt = 0 THEN co.quantity ELSE 0 END), 0.0) AS orderedQuantity,
    (ci.quantity - COALESCE(SUM(CASE WHEN bdc.is_debt = 0 THEN co.quantity ELSE 0 END), 0.0)) AS remainingQuantity
FROM convention_item ci
LEFT JOIN commande_item co ON co.convention_item_id = ci.id
LEFT JOIN bon_de_commande bdc ON co.commande_id = bdc.id
WHERE ci.convention_id = ?
GROUP BY ci.id
ORDER BY ci.designation ASC;

-- ============================================================================
-- Service & Local Queries
-- ============================================================================

selectAllServices:
SELECT * FROM service ORDER BY name ASC;

selectAllServicesWithChef:
SELECT s.*, p.full_name AS chef_name
FROM service s
LEFT JOIN person p ON s.chef_id = p.id
ORDER BY s.name ASC;

selectServiceById:
SELECT * FROM service WHERE id = ?;

selectServiceByIdWithChef:
SELECT s.*, p.full_name AS chef_name
FROM service s
LEFT JOIN person p ON s.chef_id = p.id
WHERE s.id = ?;

insertService:
INSERT INTO service (name, local_num) VALUES (?, ?);

insertServiceWithChef:
INSERT INTO service (name, local_num, chef_id) VALUES (?, ?, ?);

updateService:
UPDATE service SET name = ?, local_num = ? WHERE id = ?;

updateServiceChef:
UPDATE service SET chef_id = ? WHERE id = ?;

clearServiceChef:
UPDATE service SET chef_id = NULL WHERE id = ?;

deleteService:
DELETE FROM service WHERE id = ?;

selectAllLocals:
SELECT * FROM local ORDER BY name ASC;

selectLocalsByServiceId:
SELECT * FROM local WHERE service_id = ? ORDER BY name ASC;

selectLocalById:
SELECT * FROM local WHERE id = ?;

insertLocal:
INSERT INTO local (service_id, name) VALUES (?, ?);

updateLocal:
UPDATE local SET service_id = ?, name = ? WHERE id = ?;

deleteLocal:
DELETE FROM local WHERE id = ?;

-- ============================================================================
-- Stock Inventory Queries
-- ============================================================================

selectAllStockArticles:
SELECT * FROM stock_article ORDER BY designation ASC;

selectAllActiveStockArticles:
SELECT * FROM stock_article WHERE is_archived = 0 AND is_obsolete = 0 ORDER BY designation ASC;

selectStockArticleById:
SELECT * FROM stock_article WHERE id = ?;

selectStockArticleByCode:
SELECT * FROM stock_article WHERE code_article = ?;

selectStockArticleByBarcode:
SELECT * FROM stock_article WHERE additional_reference_id = ?;

selectStockArticleByDesignation:
SELECT * FROM stock_article WHERE designation = ?;

searchStockArticles:
SELECT * FROM stock_article 
WHERE designation LIKE ('%' || :query || '%') 
   OR code_article LIKE ('%' || :query || '%') 
   OR additional_reference_id LIKE ('%' || :query || '%')
   OR family LIKE ('%' || :query || '%') 
   OR sous_family LIKE ('%' || :query || '%')
ORDER BY designation ASC;

selectLowStockArticles:
SELECT s.*, ci.min_quantity AS alert_threshold
FROM stock_article s
JOIN convention_item ci ON s.designation = ci.designation
WHERE s.quantity <= ci.min_quantity AND s.is_archived = 0 AND s.is_obsolete = 0;

insertStockArticle:
INSERT INTO stock_article (code_article, additional_reference_id, designation, unite_quantite, family, sous_family, quantity, unit_price, expiration_date, is_archived, is_obsolete, date)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateStockArticle:
UPDATE stock_article 
SET code_article = ?, additional_reference_id = ?, designation = ?, unite_quantite = ?, family = ?, sous_family = ?, quantity = ?, unit_price = ?, expiration_date = ?, is_archived = ?, is_obsolete = ?, date = ? 
WHERE id = ?;

archiveStockArticle:
UPDATE stock_article SET is_archived = 1 WHERE id = ?;

unarchiveStockArticle:
UPDATE stock_article SET is_archived = 0 WHERE id = ?;

markStockArticleObsolete:
UPDATE stock_article SET is_obsolete = 1 WHERE id = ?;

deleteStockArticle:
DELETE FROM stock_article WHERE id = ?;

-- Atomic Stock Mutations
increaseStockQuantity:
UPDATE stock_article 
SET quantity = quantity + ?, date = ? 
WHERE code_article = ?;

increaseStockQuantityByDesignation:
UPDATE stock_article 
SET quantity = quantity + ?, date = ? 
WHERE designation = ?;

decreaseStockQuantity:
UPDATE stock_article 
SET quantity = quantity - ?, date = ? 
WHERE code_article = ?;

decreaseStockQuantityById:
UPDATE stock_article 
SET quantity = quantity - ?, date = ? 
WHERE id = ?;

increaseStockQuantityById:
UPDATE stock_article 
SET quantity = quantity + ?, date = ? 
WHERE id = ?;

insertOrReplaceStockArticle:
INSERT OR REPLACE INTO stock_article (id, code_article, additional_reference_id, designation, unite_quantite, family, sous_family, quantity, unit_price, expiration_date, is_archived, is_obsolete, date)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

