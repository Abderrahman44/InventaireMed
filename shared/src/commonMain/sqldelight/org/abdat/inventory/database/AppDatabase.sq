-- Metadata table for configuration and system state
CREATE TABLE app_metadata (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

getMetadata:
SELECT value FROM app_metadata WHERE key = ?;

setMetadata:
INSERT OR REPLACE INTO app_metadata(key, value) VALUES (?, ?);

-- ============================================================================
-- Master Entities
-- ============================================================================

-- 1. Fournisseur (Supplier)
CREATE TABLE fournisseur (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    full_name TEXT NOT NULL,
    societe TEXT NOT NULL DEFAULT '',
    phone TEXT NOT NULL DEFAULT '',
    responsable_phone TEXT NOT NULL DEFAULT '',
    ville TEXT NOT NULL DEFAULT '',
    email TEXT NOT NULL DEFAULT '',
    other_links TEXT NOT NULL DEFAULT ''
);

-- 2. Convention (Supplier Agreement)
CREATE TABLE convention (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    fournisseur_id INTEGER NOT NULL REFERENCES fournisseur(id) ON DELETE CASCADE,
    ord_number INTEGER NOT NULL,
    date TEXT NOT NULL,
    global_unit_price REAL NOT NULL DEFAULT 0.0,
    total_montant REAL NOT NULL DEFAULT 0.0,
    tva_rate REAL NOT NULL DEFAULT 0.0
);

-- 3. Convention Items (Agreed products under a convention)
CREATE TABLE convention_item (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    convention_id INTEGER NOT NULL REFERENCES convention(id) ON DELETE CASCADE,
    designation TEXT NOT NULL,
    unite TEXT NOT NULL,
    quantity REAL NOT NULL,
    min_quantity REAL NOT NULL DEFAULT 0.0
);

-- 4. Internal Organization: Service (Department)
CREATE TABLE service (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    local_num TEXT NOT NULL DEFAULT '',
    chef_id INTEGER REFERENCES person(id) ON DELETE SET NULL
);

-- 5. Internal Organization: Local (Room/Storage area)
CREATE TABLE local (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    service_id INTEGER NOT NULL REFERENCES service(id) ON DELETE CASCADE,
    name TEXT NOT NULL
);

-- 6. Stock (Inventory Master)
CREATE TABLE stock_article (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    code_article TEXT NOT NULL UNIQUE,
    additional_reference_id TEXT NOT NULL DEFAULT '',
    designation TEXT NOT NULL,
    unite_quantite TEXT NOT NULL,
    family TEXT NOT NULL DEFAULT '',
    sous_family TEXT NOT NULL DEFAULT '',
    quantity REAL NOT NULL DEFAULT 0.0,
    unit_price REAL NOT NULL DEFAULT 0.0,
    expiration_date TEXT,
    is_archived INTEGER NOT NULL DEFAULT 0,
    is_obsolete INTEGER NOT NULL DEFAULT 0,
    date TEXT NOT NULL
);

-- 6b. Article Audit Log
CREATE TABLE article_audit_log (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    article_id INTEGER NOT NULL REFERENCES stock_article(id) ON DELETE CASCADE,
    field_name TEXT NOT NULL,
    old_value TEXT NOT NULL DEFAULT '',
    new_value TEXT NOT NULL DEFAULT '',
    reason TEXT NOT NULL,
    user_name TEXT NOT NULL DEFAULT 'Admin',
    edit_date TEXT NOT NULL
);

-- ============================================================================
-- Transaction Documents
-- ============================================================================

-- 7. Bon de Commande (Purchase Order)
CREATE TABLE bon_de_commande (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    reference_bon TEXT NOT NULL,
    fournisseur_id INTEGER NOT NULL REFERENCES fournisseur(id) ON DELETE RESTRICT,
    date TEXT NOT NULL,
    is_debt INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE commande_item (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    commande_id INTEGER NOT NULL REFERENCES bon_de_commande(id) ON DELETE CASCADE,
    convention_item_id INTEGER REFERENCES convention_item(id) ON DELETE SET NULL,
    code_article TEXT NOT NULL DEFAULT '',
    designation TEXT NOT NULL,
    type TEXT NOT NULL,
    family TEXT NOT NULL DEFAULT '',
    quantity REAL NOT NULL,
    unit_price REAL NOT NULL DEFAULT 0.0
);

-- 8. Bon de Livraison (Delivery Note)
CREATE TABLE bon_de_livraison (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    reference_bon TEXT NOT NULL,
    fournisseur_id INTEGER NOT NULL REFERENCES fournisseur(id) ON DELETE RESTRICT,
    date_livraison TEXT NOT NULL,
    commande_id INTEGER REFERENCES bon_de_commande(id) ON DELETE SET NULL,
    service_id INTEGER REFERENCES service(id) ON DELETE SET NULL,
    beneficiaire_id INTEGER REFERENCES person(id) ON DELETE SET NULL
);

CREATE TABLE livraison_item (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    livraison_id INTEGER NOT NULL REFERENCES bon_de_livraison(id) ON DELETE CASCADE,
    code_article TEXT NOT NULL,
    designation TEXT NOT NULL,
    quantity REAL NOT NULL,
    unit_price REAL NOT NULL DEFAULT 0.0
);

-- 9. Bon de Sortie (Consumption / Issue Note)
CREATE TABLE bon_de_sortie (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    reference_bon TEXT NOT NULL,
    service_id INTEGER NOT NULL REFERENCES service(id) ON DELETE RESTRICT,
    local_id INTEGER REFERENCES local(id) ON DELETE SET NULL,
    date TEXT NOT NULL,
    demandeur TEXT NOT NULL DEFAULT '',
    recepteur_interne TEXT NOT NULL DEFAULT '',
    motif TEXT NOT NULL DEFAULT ''
);

CREATE TABLE sortie_item (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    sortie_id INTEGER NOT NULL REFERENCES bon_de_sortie(id) ON DELETE CASCADE,
    code_article TEXT NOT NULL,
    designation TEXT NOT NULL,
    quantity REAL NOT NULL
);

-- 10. Papier de Décharge (Gifts & Donations Inflow)
CREATE TABLE papier_decharge (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    reference_bon TEXT NOT NULL UNIQUE,
    organization_name TEXT NOT NULL,
    donor_name TEXT NOT NULL DEFAULT '',
    date TEXT NOT NULL,
    notes TEXT NOT NULL DEFAULT ''
);

CREATE TABLE decharge_item (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    decharge_id INTEGER NOT NULL REFERENCES papier_decharge(id) ON DELETE CASCADE,
    code_article TEXT NOT NULL,
    designation TEXT NOT NULL,
    quantity REAL NOT NULL,
    unit_price REAL NOT NULL DEFAULT 0.0
);

-- 11. Personnel & Equipment Allocation (Dotation)
CREATE TABLE person (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    service_id INTEGER NOT NULL REFERENCES service(id) ON DELETE CASCADE,
    full_name TEXT NOT NULL,
    birth_date TEXT NOT NULL DEFAULT '',
    notes TEXT NOT NULL DEFAULT ''
);

CREATE TABLE equipment_assignment (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    person_id INTEGER NOT NULL REFERENCES person(id) ON DELETE CASCADE,
    article_id INTEGER NOT NULL REFERENCES stock_article(id) ON DELETE RESTRICT,
    quantity REAL NOT NULL DEFAULT 1.0,
    assigned_date TEXT NOT NULL,
    return_date TEXT,
    status TEXT NOT NULL DEFAULT 'ACTIVE',
    notes TEXT NOT NULL DEFAULT ''
);

-- 12. Dynamic Configurations & User Preferences
CREATE TABLE dynamic_config_item (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    category TEXT NOT NULL,
    code TEXT NOT NULL,
    label TEXT NOT NULL,
    parent_category TEXT NOT NULL DEFAULT '',
    parent_code TEXT NOT NULL DEFAULT '',
    is_active INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE user_profile (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1,
    full_name TEXT NOT NULL DEFAULT 'Administrateur',
    phone TEXT NOT NULL DEFAULT '',
    email TEXT NOT NULL DEFAULT '',
    role TEXT NOT NULL DEFAULT 'Responsable Stock',
    theme_mode TEXT NOT NULL DEFAULT 'LIGHT',
    locale TEXT NOT NULL DEFAULT 'FR'
);

-- ============================================================================
-- Database Indexes
-- ============================================================================

CREATE INDEX idx_convention_fournisseur ON convention(fournisseur_id);
CREATE INDEX idx_convention_item_convention ON convention_item(convention_id);
CREATE INDEX idx_local_service ON local(service_id);
CREATE INDEX idx_stock_article_code ON stock_article(code_article);
CREATE INDEX idx_stock_article_barcode ON stock_article(additional_reference_id);
CREATE INDEX idx_stock_article_designation ON stock_article(designation);
CREATE INDEX idx_stock_article_family ON stock_article(family);
CREATE INDEX idx_audit_article ON article_audit_log(article_id);
CREATE INDEX idx_commande_fournisseur ON bon_de_commande(fournisseur_id);
CREATE INDEX idx_commande_item_commande ON commande_item(commande_id);
CREATE INDEX idx_commande_item_convention ON commande_item(convention_item_id);
CREATE INDEX idx_livraison_fournisseur ON bon_de_livraison(fournisseur_id);
CREATE INDEX idx_livraison_service ON bon_de_livraison(service_id);
CREATE INDEX idx_livraison_beneficiaire ON bon_de_livraison(beneficiaire_id);
CREATE INDEX idx_livraison_item_livraison ON livraison_item(livraison_id);
CREATE INDEX idx_sortie_service ON bon_de_sortie(service_id);
CREATE INDEX idx_sortie_item_sortie ON sortie_item(sortie_id);
CREATE INDEX idx_decharge_ref ON papier_decharge(reference_bon);
CREATE INDEX idx_decharge_item_decharge ON decharge_item(decharge_id);
CREATE INDEX idx_person_service ON person(service_id);
CREATE INDEX idx_assignment_person ON equipment_assignment(person_id);
CREATE INDEX idx_assignment_article ON equipment_assignment(article_id);
CREATE INDEX idx_config_category ON dynamic_config_item(category);

-- ============================================================================
-- Utility Queries
-- ============================================================================

selectLastInsertedRowId:
SELECT last_insert_rowid();

-- ============================================================================
-- Fournisseur Queries
