-- ============================================================================
-- Personnel Queries
-- ============================================================================

selectAllPersons:
SELECT p.*, s.name AS service_name, (CASE WHEN s.chef_id = p.id THEN 1 ELSE 0 END) AS is_chef
FROM person p
JOIN service s ON p.service_id = s.id
ORDER BY p.full_name ASC;

selectPersonsByServiceId:
SELECT p.*, s.name AS service_name, (CASE WHEN s.chef_id = p.id THEN 1 ELSE 0 END) AS is_chef
FROM person p
JOIN service s ON p.service_id = s.id
WHERE p.service_id = ?
ORDER BY p.full_name ASC;

selectPersonById:
SELECT p.*, s.name AS service_name, (CASE WHEN s.chef_id = p.id THEN 1 ELSE 0 END) AS is_chef
FROM person p
JOIN service s ON p.service_id = s.id
WHERE p.id = ?;

selectChefByServiceId:
SELECT p.*, s.name AS service_name, 1 AS is_chef
FROM person p
JOIN service s ON s.chef_id = p.id
WHERE s.id = ?;

insertPerson:
INSERT INTO person (service_id, full_name, birth_date, notes)
VALUES (?, ?, ?, ?);

updatePerson:
UPDATE person SET service_id = ?, full_name = ?, birth_date = ?, notes = ? WHERE id = ?;

deletePerson:
DELETE FROM person WHERE id = ?;

-- ============================================================================
-- Equipment Assignment (Dotation) Queries
-- ============================================================================

selectAllAssignments:
SELECT a.*, p.full_name AS person_name, s.designation AS article_designation, s.code_article AS article_code, s.unite_quantite AS unite
FROM equipment_assignment a
JOIN person p ON a.person_id = p.id
JOIN stock_article s ON a.article_id = s.id
ORDER BY a.assigned_date DESC, a.id DESC;

selectAssignmentsByPersonId:
SELECT a.*, p.full_name AS person_name, s.designation AS article_designation, s.code_article AS article_code, s.unite_quantite AS unite
FROM equipment_assignment a
JOIN person p ON a.person_id = p.id
JOIN stock_article s ON a.article_id = s.id
WHERE a.person_id = ?
ORDER BY a.assigned_date DESC, a.id DESC;

insertEquipmentAssignment:
INSERT INTO equipment_assignment (person_id, article_id, quantity, assigned_date, return_date, status, notes)
VALUES (?, ?, ?, ?, ?, ?, ?);

returnEquipmentAssignment:
UPDATE equipment_assignment
SET return_date = ?, status = 'RETURNED'
WHERE id = ?;

-- ============================================================================
-- Dynamic Configurations Queries
-- ============================================================================

selectAllConfigItems:
SELECT * FROM dynamic_config_item ORDER BY category ASC, label ASC;

selectConfigItemsByCategory:
SELECT * FROM dynamic_config_item WHERE category = ? AND is_active = 1 ORDER BY label ASC;

insertConfigItem:
INSERT INTO dynamic_config_item (category, code, label, parent_category, parent_code, is_active)
VALUES (?, ?, ?, ?, ?, ?);

updateConfigItem:
UPDATE dynamic_config_item SET label = ?, parent_code = ?, is_active = ? WHERE id = ?;

deleteConfigItem:
DELETE FROM dynamic_config_item WHERE id = ?;

-- Article category taxonomy. Rows of every activity state are returned so the configuration screen
-- can still list and delete inactive ones; CategoryTaxonomy narrows to active rows for selection.
selectAllCategoryItems:
SELECT * FROM dynamic_config_item
WHERE category IN ('FAMILY', 'SOUS_FAMILY')
ORDER BY label ASC;

-- Category usage across all articles, archived and obsolete included. Grouped on the raw labels and
-- matched in Kotlin: SQLite's LOWER() folds ASCII only, so 'MATÉRIEL' and 'matériel' would not meet.
selectArticleCategoryUsage:
SELECT family, sous_family, COUNT(*) AS article_count
FROM stock_article
GROUP BY family, sous_family;

-- ============================================================================
-- User Profile Queries
-- ============================================================================

getUserProfile:
SELECT * FROM user_profile WHERE id = 1;

insertOrUpdateUserProfile:
INSERT OR REPLACE INTO user_profile (id, full_name, phone, email, role, theme_mode, locale)
VALUES (1, ?, ?, ?, ?, ?, ?);
